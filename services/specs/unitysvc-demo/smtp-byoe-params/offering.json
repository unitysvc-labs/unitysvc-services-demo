{
  "capabilities": [
    "smtp_relay"
  ],
  "description": "Each enrollment connects to a different SMTP server — customers provide the names of their own secrets as parameters, enabling multiple relay configurations (personal Gmail, work SendGrid, transactional SES, etc.) under a single account.",
  "name": "smtp-byoe-params",
  "payout_price": {
    "description": "No platform commission — customer uses own SMTP",
    "percentage": "100.00",
    "type": "revenue_share"
  },
  "service_type": "email",
  "status": "ready",
  "summary": "Multi-enrollment BYOE SMTP relay.",
  "time_created": "2026-04-18T00:00:00Z",
  "upstream_access_config": {
    "customer_smtp": {
      "access_method": "smtp",
      "host": "{{ params.host }}",
      "params": {
        "schema": {
          "properties": {
            "host": {
              "description": "SMTP hostname",
              "type": "string"
            },
            "password": {
              "description": "SMTP password. Paste it or pick one of your secrets; it is kept as a secret and not shown again.",
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            "port": {
              "description": "SMTP port",
              "type": "string"
            },
            "username": {
              "description": "SMTP username",
              "type": "string"
            }
          },
          "required": [
            "host",
            "port",
            "username",
            "password"
          ],
          "type": "object"
        },
        "testing_defaults": {
          "host": "${ customer_secrets.DEMO_SMTP_RELAY_HOST }",
          "password": "${ customer_secrets.DEMO_SMTP_RELAY_PASSWORD }",
          "port": "${ customer_secrets.DEMO_SMTP_RELAY_PORT }",
          "username": "${ customer_secrets.DEMO_SMTP_RELAY_USERNAME }"
        }
      },
      "password": "{{ params.password }}",
      "port": "{{ params.port }}",
      "tls": false,
      "username": "{{ params.username }}"
    }
  }
}
