{
  "capabilities": [
    "http-relay"
  ],
  "description": "At enrollment the customer picks a `model` value; the platform uses it as the routing key so requests carrying `{\"model\": \"<value>\"}` are routed to this service.",
  "name": "params",
  "service_type": "proxy",
  "status": "ready",
  "summary": "Parameterized echo relay.",
  "time_created": "2026-04-18T00:00:00Z",
  "upstream_access_config": {
    "echo_service": {
      "access_method": "http",
      "base_url": "https://mock.unitysvc.dev/openai",
      "params": {
        "schema": {
          "properties": {
            "model": {
              "description": "Model identifier used as the routing key for this enrollment",
              "title": "Model",
              "type": "string"
            }
          },
          "required": [
            "model"
          ],
          "type": "object"
        },
        "testing_defaults": {
          "model": "echo-default"
        }
      },
      "routing_key": {
        "model": "{{ params.model }}"
      }
    }
  }
}
