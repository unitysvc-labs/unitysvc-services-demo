{
  "capabilities": [
    "s3_browse",
    "s3_download"
  ],
  "description": "The customer supplies parameter values that name which of their secrets hold the upstream endpoint, bucket, region, and credentials, so one offering can serve many distinct buckets per customer. The region field falls back to `us-east-1` via the `?? us-east-1` default operator if the named secret isn't set.",
  "name": "s3-byoe-params",
  "payout_price": {
    "description": "No platform commission — customer uses own bucket",
    "percentage": "100.00",
    "type": "revenue_share"
  },
  "service_type": "content",
  "status": "ready",
  "summary": "BYOE S3 relay with per-enrollment secret selection.",
  "time_created": "2026-04-18T00:00:00Z",
  "upstream_access_config": {
    "s3_upstream": {
      "access_key": "{{ params.s3_access_key }}",
      "access_method": "http",
      "bucket": "{{ params.s3_bucket }}",
      "params": {
        "schema": {
          "properties": {
            "s3_access_key": {
              "description": "S3 access key ID. Paste it or pick one of your secrets; it is kept as a secret and not shown again.",
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            "s3_bucket": {
              "description": "Bucket name",
              "type": "string"
            },
            "s3_endpoint": {
              "description": "S3-compatible endpoint URL (e.g. https://s3.amazonaws.com)",
              "type": "string"
            },
            "s3_region": {
              "description": "Region (e.g. us-east-1)",
              "type": "string"
            },
            "s3_secret_key": {
              "description": "S3 secret access key. Paste it or pick one of your secrets; it is kept as a secret and not shown again.",
              "format": "password",
              "type": "string",
              "writeOnly": true
            }
          },
          "required": [
            "s3_endpoint",
            "s3_bucket",
            "s3_region",
            "s3_access_key",
            "s3_secret_key"
          ],
          "type": "object"
        },
        "testing_defaults": {
          "s3_access_key": "${ secrets.S3_ACCESS_KEY }",
          "s3_bucket": "demo",
          "s3_endpoint": "https://s3.unitysvc.dev",
          "s3_region": "us-east-1",
          "s3_secret_key": "${ secrets.S3_SECRET_KEY }"
        }
      },
      "region": "{{ params.s3_region }}",
      "s3_endpoint": "{{ params.s3_endpoint }}",
      "secret_key": "{{ params.s3_secret_key }}",
      "storage_type": "s3"
    }
  }
}
